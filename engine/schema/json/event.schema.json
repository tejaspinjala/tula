{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event",
  "type": "object",
  "properties": {
    "ts": {
      "$ref": "#/$defs/ts"
    },
    "type": {
      "type": "string",
      "enum": [
        "run.start",
        "run.end",
        "msg.delegate",
        "msg.report",
        "msg.human",
        "tool.call",
        "tool.result",
        "tool.denied",
        "usage",
        "ctx",
        "compact",
        "handoff",
        "error",
        "task.transition",
        "approval.requested",
        "approval.decided",
        "verdict.issued",
        "access.requested",
        "access.granted",
        "access.escalated",
        "detector.alert",
        "schedule.fired",
        "kill.on",
        "kill.off",
        "provider.degraded",
        "provider.recovered",
        "workflow.instance.start",
        "workflow.node.state",
        "workflow.instance.end",
        "config.changed",
        "config.pending_confirmation",
        "connection.health",
        "manual_action.requested",
        "manual_action.completed"
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "hook",
        "adapter",
        "otel",
        "fleetd",
        "gateway",
        "ui"
      ]
    },
    "runId": {
      "$ref": "#/$defs/id"
    },
    "taskId": {
      "$ref": "#/$defs/id"
    },
    "workflowInstanceId": {
      "$ref": "#/$defs/id"
    },
    "nodeId": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,40}$"
    },
    "sim": {
      "type": "boolean"
    },
    "agentId": {
      "type": "string"
    },
    "parentAgentId": {
      "type": "string"
    },
    "from": {
      "type": "string"
    },
    "to": {
      "type": "string"
    },
    "text": {
      "description": "redacted; private-class text replaced by '[private]' outside private views",
      "type": "string",
      "maxLength": 400
    },
    "tool": {
      "type": "string"
    },
    "usage": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "in": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "out": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cacheRead": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cacheWrite": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "costUsd": {
          "type": "number",
          "minimum": 0
        },
        "quotaUnits": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "ctxPct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "data": {
      "description": "type-specific extras, schema per type in engine/schema/event.ts",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "ts",
    "type",
    "source"
  ],
  "additionalProperties": false,
  "$defs": {
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 date-time"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{0,15}_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "Entity id: <prefix>_<26 Crockford base32>, as produced by engine/lib/ids.ts newId()"
    }
  }
}
