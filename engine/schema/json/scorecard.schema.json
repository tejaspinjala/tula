{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scorecard",
  "type": "object",
  "properties": {
    "runId": {
      "$ref": "#/$defs/id"
    },
    "taskId": {
      "$ref": "#/$defs/id"
    },
    "goalId": {
      "type": "string"
    },
    "agentId": {
      "type": "string",
      "minLength": 1
    },
    "roleId": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "tokensIn": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "tokensOut": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cacheRead": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "costUsd": {
      "type": "number",
      "minimum": 0
    },
    "quotaUnits": {
      "type": "number",
      "minimum": 0
    },
    "turns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "wallMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "peakCtxPct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "retries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "gateDenials": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "accessRequests": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "helperCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "loopFlags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "stuck",
          "loop",
          "ctx_over",
          "gate_thrash",
          "waste"
        ]
      }
    },
    "acceptanceMet": {
      "type": "boolean"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "judgeIndependence": {
      "type": "string",
      "enum": [
        "strong",
        "weak"
      ]
    },
    "reworkOf": {
      "$ref": "#/$defs/id"
    },
    "failover": {
      "type": "boolean"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "ok",
        "failed",
        "handoff",
        "killed",
        "failover"
      ]
    }
  },
  "required": [
    "runId",
    "agentId",
    "roleId",
    "provider",
    "model",
    "tokensIn",
    "tokensOut",
    "costUsd",
    "turns",
    "wallMs",
    "peakCtxPct",
    "outcome"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{0,15}_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "Entity id: <prefix>_<26 Crockford base32>, as produced by engine/lib/ids.ts newId()"
    }
  }
}
