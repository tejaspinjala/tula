{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{0,15}_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "Entity id: <prefix>_<26 Crockford base32>, as produced by engine/lib/ids.ts newId()"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
      "description": "Configuration object id: lowercase letters, digits and dashes, 2-64 chars"
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 date-time"
    },
    "tier": {
      "type": "string",
      "enum": [
        "cheap",
        "mid",
        "deep"
      ]
    },
    "dataClass": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "private",
        "secret"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "usd": {
      "type": "number",
      "minimum": 0
    },
    "autonomy": {
      "type": "string",
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3"
      ]
    },
    "authMode": {
      "type": "string",
      "enum": [
        "api",
        "browser",
        "manual"
      ]
    },
    "postingMode": {
      "type": "string",
      "enum": [
        "manual",
        "approve_then_auto",
        "auto_when_unavailable",
        "auto"
      ]
    },
    "tosRisk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "jsonSchema": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {},
      "description": "An embedded JSON Schema document"
    },
    "scope": {
      "type": "object",
      "properties": {
        "read": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "write": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "shell": {
          "description": "allowed command prefixes",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gatewayTools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nativeTools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "netDomains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dataClasses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dataClass"
          }
        },
        "usd": {
          "$ref": "#/$defs/usd"
        },
        "tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "evidenceRef": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "test_output",
            "command_log",
            "commit",
            "screenshot",
            "video",
            "file_line",
            "url",
            "metric",
            "brain_note"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "note": {
          "type": "string",
          "maxLength": 300
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "additionalProperties": false
    },
    "doneCondition": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "command",
            "tests",
            "schema",
            "rubric"
          ]
        },
        "spec": {
          "type": "string",
          "minLength": 1
        },
        "timeoutSec": {
          "default": 300,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kind",
        "spec"
      ],
      "additionalProperties": false
    }
  }
}
