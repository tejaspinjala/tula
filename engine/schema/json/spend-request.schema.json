{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spend-request",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/id"
    },
    "requesterAgentId": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "$ref": "#/$defs/id"
    },
    "goalId": {
      "type": "string",
      "minLength": 1
    },
    "envelopeId": {
      "type": "string",
      "minLength": 1
    },
    "amount": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "currency": {
      "type": "string",
      "const": "USD"
    },
    "recurring": {
      "type": "object",
      "properties": {
        "every": {
          "type": "string",
          "enum": [
            "month",
            "year"
          ]
        },
        "until": {
          "$ref": "#/$defs/ts"
        }
      },
      "additionalProperties": false
    },
    "vendor": {
      "type": "string",
      "minLength": 1
    },
    "item": {
      "type": "string",
      "minLength": 1
    },
    "why": {
      "type": "string",
      "maxLength": 600
    },
    "expectedRoi": {
      "type": "object",
      "properties": {
        "metric": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "horizonDays": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "metric",
        "value",
        "horizonDays"
      ],
      "additionalProperties": false
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mode": {
      "type": "string",
      "enum": [
        "paper",
        "real"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "finance_review",
        "owner_review",
        "approved",
        "denied",
        "executed",
        "expired"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "pass": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "financeVerdict": {
      "type": "object",
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "approve",
            "deny",
            "escalate"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "approvalId": {
      "$ref": "#/$defs/id"
    },
    "receipt": {
      "$ref": "#/$defs/evidenceRef"
    },
    "expiresAt": {
      "$ref": "#/$defs/ts"
    },
    "createdAt": {
      "$ref": "#/$defs/ts"
    }
  },
  "required": [
    "id",
    "requesterAgentId",
    "goalId",
    "envelopeId",
    "amount",
    "currency",
    "vendor",
    "item",
    "why",
    "expectedRoi",
    "mode",
    "status",
    "createdAt"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{0,15}_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "Entity id: <prefix>_<26 Crockford base32>, as produced by engine/lib/ids.ts newId()"
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 date-time"
    },
    "evidenceRef": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "test_output",
            "command_log",
            "commit",
            "screenshot",
            "video",
            "file_line",
            "url",
            "metric",
            "brain_note"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "note": {
          "type": "string",
          "maxLength": 300
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "additionalProperties": false
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
