{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "team",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "departmentId": {
      "$ref": "#/$defs/slug"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "purpose": {
      "type": "string",
      "maxLength": 300
    },
    "managerAgentId": {
      "$ref": "#/$defs/slug"
    },
    "memberAgentIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "connectionIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "workflowIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "goalIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "envelopeId": {
      "type": "string"
    },
    "autonomy": {
      "description": "capped at the department level by the config service",
      "$ref": "#/$defs/autonomy"
    },
    "dataClass": {
      "$ref": "#/$defs/dataClass"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "dormant",
        "retired"
      ]
    },
    "fromTemplate": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "departmentId",
    "name",
    "managerAgentId",
    "memberAgentIds",
    "status"
  ],
  "additionalProperties": false,
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
      "description": "Configuration object id: lowercase letters, digits and dashes, 2-64 chars"
    },
    "autonomy": {
      "type": "string",
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3"
      ]
    },
    "dataClass": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "private",
        "secret"
      ]
    }
  }
}
