{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "routing",
  "type": "object",
  "properties": {
    "defaultTier": {
      "$ref": "#/$defs/tier"
    },
    "taskTypes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "taskType": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)*$"
          },
          "tier": {
            "$ref": "#/$defs/tier"
          },
          "minTier": {
            "description": "floor after escalation, e.g. deep for irreversible planning",
            "$ref": "#/$defs/tier"
          },
          "judgeFamily": {
            "type": "string",
            "enum": [
              "other_than_implementer",
              "any"
            ]
          },
          "notes": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "taskType",
          "tier"
        ],
        "additionalProperties": false
      }
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "match": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "taskType": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)*$"
          }
        },
        "required": [
          "id",
          "match",
          "taskType"
        ],
        "additionalProperties": false
      }
    },
    "classifier": {
      "description": "fallback classifier when no keyword matches",
      "type": "object",
      "properties": {
        "taskType": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)*$"
        },
        "tier": {
          "$ref": "#/$defs/tier"
        }
      },
      "required": [
        "taskType",
        "tier"
      ],
      "additionalProperties": false
    },
    "escalation": {
      "type": "object",
      "properties": {
        "riskHigh": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "filesOver": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "filesStep": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "failedAttempt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      },
      "required": [
        "riskHigh",
        "filesOver",
        "filesStep",
        "failedAttempt"
      ],
      "additionalProperties": false
    },
    "flagFloors": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "external",
          "irreversible"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/tier"
      }
    }
  },
  "required": [
    "defaultTier",
    "taskTypes",
    "escalation"
  ],
  "additionalProperties": false,
  "$defs": {
    "tier": {
      "type": "string",
      "enum": [
        "cheap",
        "mid",
        "deep"
      ]
    }
  }
}
