{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "config-version",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "hash": {
      "$ref": "#/$defs/sha256"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{7,64}$"
    },
    "actor": {
      "type": "string",
      "pattern": "^(owner|file|template:[a-z0-9][a-z0-9-]{1,63}|[a-z0-9][a-z0-9-]{1,63})$",
      "description": "'owner' | 'file' | 'template:<id>' | agentId (proposals only)"
    },
    "ts": {
      "$ref": "#/$defs/ts"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "pending_confirmation",
        "rejected",
        "superseded"
      ]
    },
    "riskWidening": {
      "type": "boolean"
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "effective": {
      "type": "string",
      "enum": [
        "now",
        "next_run"
      ]
    },
    "confirmedAt": {
      "$ref": "#/$defs/ts"
    }
  },
  "required": [
    "kind",
    "id",
    "version",
    "hash",
    "actor",
    "ts",
    "status",
    "riskWidening"
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 date-time"
    }
  }
}
