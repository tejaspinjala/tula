{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "teamId": {
      "$ref": "#/$defs/slug"
    },
    "params": {
      "description": "JSON Schema for instance/template params",
      "$ref": "#/$defs/jsonSchema"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "archived",
        "pending_confirmation"
      ]
    },
    "nodes": {
      "minItems": 2,
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxUsdPerInstance": {
          "type": "number",
          "minimum": 0
        },
        "maxConcurrentInstances": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "createdBy": {
      "type": "string"
    },
    "updatedAt": {
      "$ref": "#/$defs/ts"
    }
  },
  "required": [
    "id",
    "version",
    "name",
    "status",
    "nodes",
    "edges"
  ],
  "additionalProperties": false,
