{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "limits",
  "type": "object",
  "properties": {
    "dailyTokenCapUsd": {
      "description": "company-wide API-equivalent token spend per day",
      "$ref": "#/$defs/usd"
    },
    "maxRunUsd": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/tier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/usd"
      },
      "description": "per-Run cap by tier"
    },
    "meetingCapUsd": {
      "$ref": "#/$defs/usd"
    },
    "wip": {
      "type": "object",
      "properties": {
        "projectsPerGoal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "runningTasksPerGoal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "runningTasksCompany": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "projectsPerGoal",
        "runningTasksPerGoal",
        "runningTasksCompany"
      ],
      "additionalProperties": false
    },
    "maxConcurrentExperiments": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "handoffCtxPct": {
      "type": "number",
      "minimum": 5,
      "maximum": 95,
      "description": "context % at which a Run hands off and restarts"
    },
    "browserStepCap": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "dailyTokenCapUsd",
    "maxRunUsd",
    "meetingCapUsd",
    "wip",
    "maxConcurrentExperiments",
    "handoffCtxPct"
  ],
  "additionalProperties": false,
  "$defs": {
    "usd": {
      "type": "number",
      "minimum": 0
    },
    "tier": {
      "type": "string",
      "enum": [
        "cheap",
        "mid",
        "deep"
      ]
    }
  }
}
