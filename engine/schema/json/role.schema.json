{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "role",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4,
      "description": "0 owner seat, 1 director, 2 manager, 3 employee, 4 helper"
    },
    "dutiesPrompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "tier": {
      "description": "default tier",
      "$ref": "#/$defs/tier"
    },
    "maxTier": {
      "description": "highest tier a workflow node may request for this role",
      "$ref": "#/$defs/tier"
    },
    "nativeTools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gatewayTools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "description": "read/write paths, shell prefixes, domains, data classes, budgets",
      "$ref": "#/$defs/scope"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "maxTurns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "maxRunUsd": {
      "$ref": "#/$defs/usd"
    },
    "omitProjectInstructions": {
      "type": "boolean"
    },
    "goldenTasks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "canBeVerifierFor": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slug"
      }
    }
  },
  "required": [
    "id",
    "title",
    "level",
    "dutiesPrompt",
    "tier",
    "maxTier",
    "nativeTools",
    "gatewayTools",
    "scope",
    "maxTurns",
    "maxRunUsd"
  ],
  "additionalProperties": false,
  "$defs": {
    "tier": {
      "type": "string",
      "enum": [
        "cheap",
        "mid",
        "deep"
      ]
    },
    "dataClass": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "private",
        "secret"
      ]
    },
    "usd": {
      "type": "number",
      "minimum": 0
    },
    "scope": {
      "type": "object",
      "properties": {
        "read": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "write": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "shell": {
          "description": "allowed command prefixes",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gatewayTools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nativeTools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "netDomains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dataClasses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dataClass"
          }
        },
        "usd": {
          "$ref": "#/$defs/usd"
        },
        "tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
      "description": "Configuration object id: lowercase letters, digits and dashes, 2-64 chars"
    }
  }
}
