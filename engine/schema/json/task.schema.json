{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/id"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "goalId": {
      "type": "string",
      "minLength": 1
    },
    "departmentId": {
      "$ref": "#/$defs/slug"
    },
    "teamId": {
      "$ref": "#/$defs/slug"
    },
    "workflowInstanceId": {
      "$ref": "#/$defs/id"
    },
    "nodeId": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,40}$"
    },
    "sim": {
      "type": "boolean"
    },
    "parentTaskId": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140
    },
    "ownerAgentId": {
      "description": "exactly one owner",
      "$ref": "#/$defs/slug"
    },
    "taskType": {
      "description": "routing key, e.g. post.draft, brain.compile, verify",
      "type": "string",
      "minLength": 1
    },
    "acceptance": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "doneCondition": {
      "$ref": "#/$defs/doneCondition"
    },
    "status": {
      "type": "string",
      "enum": [
        "backlog",
        "ready",
        "running",
        "verify",
        "blocked",
        "awaiting_approval",
        "done",
        "cancelled"
      ]
    },
    "blockedReason": {
      "type": "string",
      "enum": [
        "deps",
        "provider",
        "private_provider_unavailable",
        "access",
        "approval",
        "budget",
        "killed",
        "other"
      ]
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "high"
      ]
    },
    "dataClass": {
      "$ref": "#/$defs/dataClass"
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "external",
          "irreversible",
          "open_ok",
          "overnight",
          "hidden_tests",
          "urgent"
        ]
      }
    },
    "deps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "inputs": {
      "description": "file/brain paths, never contents",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proposal": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "commit",
            "content"
          ]
        },
        "hash": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "hash"
      ],
      "additionalProperties": false
    },
    "verdictId": {
      "$ref": "#/$defs/id"
    },
    "approvalId": {
      "$ref": "#/$defs/id"
    },
    "estimateUsd": {
      "$ref": "#/$defs/usd"
    },
    "attempts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "runIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "dueAt": {
      "$ref": "#/$defs/ts"
    },
    "createdAt": {
      "$ref": "#/$defs/ts"
    },
    "updatedAt": {
      "$ref": "#/$defs/ts"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "id",
    "projectId",
    "goalId",
    "title",
    "ownerAgentId",
    "acceptance",
    "doneCondition",
    "status",
    "priority",
    "risk",
    "dataClass",
    "createdAt",
    "updatedAt",
    "version"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{0,15}_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "Entity id: <prefix>_<26 Crockford base32>, as produced by engine/lib/ids.ts newId()"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
      "description": "Configuration object id: lowercase letters, digits and dashes, 2-64 chars"
    },
    "doneCondition": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "command",
            "tests",
            "schema",
            "rubric"
          ]
        },
        "spec": {
          "type": "string",
          "minLength": 1
        },
        "timeoutSec": {
          "default": 300,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kind",
        "spec"
      ],
      "additionalProperties": false
    },
    "dataClass": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "private",
        "secret"
      ]
    },
    "usd": {
      "type": "number",
      "minimum": 0
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 date-time"
    }
  }
}
