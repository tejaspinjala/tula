{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow-instance",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/id"
    },
    "workflowId": {
      "$ref": "#/$defs/slug"
    },
    "workflowVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "waiting",
        "paused_killed",
        "failed",
        "done",
        "cancelled"
      ]
    },
    "trigger": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "params": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "nodeStates": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9_-]{1,40}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/nodeState"
      }
    },
    "sim": {
      "type": "boolean"
    },
    "costUsd": {
      "type": "number",
      "minimum": 0
    },
    "startedAt": {
      "$ref": "#/$defs/ts"
    },
    "endedAt": {
      "$ref": "#/$defs/ts"
    }
  },
  "required": [
    "id",
    "workflowId",
    "workflowVersion",
    "status",
    "trigger",
    "nodeStates",
    "sim",
    "startedAt"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{0,15}_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "Entity id: <prefix>_<26 Crockford base32>, as produced by engine/lib/ids.ts newId()"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
      "description": "Configuration object id: lowercase letters, digits and dashes, 2-64 chars"
    },
    "nodeState": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "running",
            "waiting",
            "done",
            "failed",
            "skipped"
          ]
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "iteration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "idempotencyKey": {
          "description": "instanceId:nodeId:iteration",
          "type": "string",
          "minLength": 1
        },
        "taskId": {
          "$ref": "#/$defs/id"
        },
        "approvalId": {
          "$ref": "#/$defs/id"
        },
        "output": {},
        "costUsd": {
          "type": "number",
          "minimum": 0
        },
        "startedAt": {
          "$ref": "#/$defs/ts"
        },
        "endedAt": {
          "$ref": "#/$defs/ts"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 date-time"
    }
  }
}
