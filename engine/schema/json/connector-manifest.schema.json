{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "connector-manifest",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,40}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "maxLength": 300
    },
    "authModes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/authMode"
      }
    },
    "configSchema": {
      "$ref": "#/$defs/jsonSchema"
    },
    "requiredSecrets": {
      "description": "per auth mode: list of secret field names",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/authMode"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/connectorAction"
      }
    },
    "healthCheck": {
      "type": "object",
      "properties": {
        "everyMin": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "kind": {
          "type": "string",
          "enum": [
            "api_ping",
            "browser_logged_in",
            "none"
          ]
        }
      },
      "additionalProperties": false
    },
    "tosRisk": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/authMode"
      },
      "additionalProperties": {
        "$ref": "#/$defs/tosRisk"
      },
      "description": "per auth mode"
    },
    "netDomains": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$"
      }
    },
    "trust": {
      "type": "string",
      "enum": [
        "builtin",
        "signed",
        "unsigned"
      ]
    },
    "signature": {
      "type": "string"
    },
    "contentHash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "required": [
    "id",
    "version",
    "platform",
    "authModes",
    "configSchema",
    "actions",
    "tosRisk",
    "trust"
  ],
  "additionalProperties": false,
  "$defs": {
    "authMode": {
      "type": "string",
      "enum": [
        "api",
        "browser",
        "manual"
      ]
    },
    "jsonSchema": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {},
      "description": "An embedded JSON Schema document"
    },
    "connectorAction": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "effect": {
          "type": "string",
          "enum": [
            "read",
            "write_internal",
            "write_external"
          ]
        },
        "authModes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/authMode"
          }
        },
        "inputSchema": {
          "$ref": "#/$defs/jsonSchema"
        },
        "outputSchema": {
          "$ref": "#/$defs/jsonSchema"
        },
        "rateLimit": {
          "type": "object",
          "properties": {
            "perHour": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "perDay": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        "status": {
          "type": "string",
          "enum": [
            "available",
            "planned"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "effect",
        "authModes",
        "inputSchema",
        "outputSchema",
        "status"
      ],
      "additionalProperties": false
    },
    "tosRisk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
