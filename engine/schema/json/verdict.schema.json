{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verdict",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/id"
    },
    "taskId": {
      "$ref": "#/$defs/id"
    },
    "proposalHash": {
      "type": "string",
      "minLength": 1
    },
    "verifierRunId": {
      "$ref": "#/$defs/id"
    },
    "judgeRunId": {
      "$ref": "#/$defs/id"
    },
    "judgeFamily": {
      "type": "string"
    },
    "independence": {
      "type": "string",
      "enum": [
        "strong",
        "weak"
      ]
    },
    "decision": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ruleKey": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "minor",
              "major",
              "blocker"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string"
          }
        },
        "required": [
          "ruleKey",
          "severity",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceRef"
      }
    },
    "issuedBy": {
      "type": "string",
      "minLength": 1
    },
    "issuedAt": {
      "$ref": "#/$defs/ts"
    }
  },
  "required": [
    "id",
    "taskId",
    "proposalHash",
    "verifierRunId",
    "independence",
    "decision",
    "reasons",
    "issuedBy",
    "issuedAt"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{0,15}_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "Entity id: <prefix>_<26 Crockford base32>, as produced by engine/lib/ids.ts newId()"
    },
    "evidenceRef": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "test_output",
            "command_log",
            "commit",
            "screenshot",
            "video",
            "file_line",
            "url",
            "metric",
            "brain_note"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "note": {
          "type": "string",
          "maxLength": 300
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "additionalProperties": false
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 date-time"
    }
  }
}
