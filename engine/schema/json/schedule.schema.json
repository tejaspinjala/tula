{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schedule",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "departmentId": {
      "$ref": "#/$defs/slug"
    },
    "goalId": {
      "type": "string"
    },
    "cron": {
      "type": "string",
      "pattern": "^(\\S+\\s+){4}\\S+$"
    },
    "tz": {
      "type": "string",
      "minLength": 1
    },
    "creates": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "workflow"
            },
            "workflowId": {
              "$ref": "#/$defs/slug"
            },
            "triggerNodeId": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{1,40}$"
            }
          },
          "required": [
            "kind",
            "workflowId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "task"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 140
            },
            "taskType": {
              "type": "string",
              "minLength": 1
            },
            "ownerAgentId": {
              "$ref": "#/$defs/slug"
            },
            "acceptance": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "kind",
            "title",
            "taskType",
            "ownerAgentId",
            "acceptance"
          ],
          "additionalProperties": false
        }
      ]
    },
    "catchUp": {
      "default": "once",
      "type": "string",
      "enum": [
        "once",
        "skip",
        "all"
      ]
    },
    "overnight": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused"
      ]
    },
    "postponeUntil": {
      "$ref": "#/$defs/ts"
    },
    "doneCondition": {
      "description": "required if overnight",
      "$ref": "#/$defs/doneCondition"
    }
  },
  "required": [
    "id",
    "cron",
    "tz",
    "creates",
    "status"
  ],
  "additionalProperties": false,
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
      "description": "Configuration object id: lowercase letters, digits and dashes, 2-64 chars"
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 date-time"
    },
    "doneCondition": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "command",
            "tests",
            "schema",
            "rubric"
          ]
        },
        "spec": {
          "type": "string",
          "minLength": 1
        },
        "timeoutSec": {
          "default": 300,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kind",
        "spec"
      ],
      "additionalProperties": false
    }
  }
}
