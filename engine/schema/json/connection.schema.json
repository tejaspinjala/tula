{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "connection",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "teamId": {
      "$ref": "#/$defs/slug"
    },
    "connectorId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,40}$"
    },
    "connectorVersion": {
      "type": "string",
      "minLength": 1
    },
    "account": {
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "handle": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "owner": {
          "type": "string",
          "enum": [
            "llc",
            "personal"
          ]
        }
      },
      "required": [
        "displayName",
        "owner"
      ],
      "additionalProperties": false
    },
    "auth": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/authMode"
        },
        "secretRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/secretRef"
          }
        },
        "identity": {
          "description": "execution service whose Infisical identity reads the refs",
          "type": "string",
          "enum": [
            "publisherd",
            "paymentd"
          ]
        },
        "profileId": {
          "description": "browser mode: encrypted profile owned by fleet-pub; one per connection",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false
    },
    "posting": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/postingMode"
        },
        "dailyLimit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unavailableAfterHours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "quietHours": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
            },
            "to": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
            },
            "tz": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "mode",
        "dailyLimit"
      ],
      "additionalProperties": false
    },
    "config": {
      "description": "validated against the connector manifest configSchema",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "sharedWithTeams": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "health": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "needs_login",
            "rate_limited",
            "error",
            "unknown"
          ]
        },
        "checkedAt": {
          "$ref": "#/$defs/ts"
        },
        "detail": {
          "type": "string",
          "maxLength": 200
        }
      },
      "additionalProperties": false
    },
    "tosAcknowledgedAt": {
      "$ref": "#/$defs/ts"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "disabled",
        "pending_confirmation"
      ]
    }
  },
  "required": [
    "id",
    "teamId",
    "connectorId",
    "connectorVersion",
    "account",
    "auth",
    "posting",
    "status"
  ],
  "additionalProperties": false,
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
      "description": "Configuration object id: lowercase letters, digits and dashes, 2-64 chars"
    },
    "authMode": {
      "type": "string",
      "enum": [
        "api",
        "browser",
        "manual"
      ]
    },
    "secretRef": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "description": "manifest requiredSecrets field name"
        },
        "project": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "environment": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
        },
        "path": {
          "type": "string",
          "pattern": "^\\/(?:[A-Za-z0-9_-]+(?:\\/[A-Za-z0-9_-]+)*)?$"
        },
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
        },
        "check": {
          "type": "string",
          "enum": [
            "unchecked",
            "exists",
            "missing",
            "forbidden"
          ]
        },
        "lastRotatedAt": {
          "$ref": "#/$defs/ts"
        }
      },
      "required": [
        "field",
        "project",
        "environment",
        "path",
        "key"
      ],
      "additionalProperties": false,
      "description": "A reference to a secret in Infisical. Never the value."
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 date-time"
    },
    "postingMode": {
      "type": "string",
      "enum": [
        "manual",
        "approve_then_auto",
        "auto_when_unavailable",
        "auto"
      ]
    }
  }
}
