{
  "id": "team-youtube-channel",
  "version": "1.0.0",
  "title": "YouTube channel team",
  "description": "A manager, a producer and an editor for one YouTube channel, plus its connection (manual by default). No secrets: set up API refs or a browser profile later in the Connections editor.",
  "kinds": [
    "team",
    "agent",
    "connection"
  ],
  "requires": {
    "schemaVersion": "1.1",
    "connectors": [
      "youtube"
    ],
    "templates": [
      "roles-content"
    ]
  },
  "params": {
    "type": "object",
    "required": [
      "channelName"
    ],
    "properties": {
      "channelName": {
        "type": "string",
        "minLength": 2,
        "maxLength": 40,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._&-]*$",
        "description": "Display name of the channel; also used (slugged) in ids"
      },
      "connectionMode": {
        "type": "string",
        "enum": [
          "api",
          "browser",
          "manual"
        ],
        "default": "manual",
        "description": "How the connection will act on the channel"
      },
      "accountOwner": {
        "type": "string",
        "enum": [
          "llc",
          "personal"
        ],
        "default": "personal"
      },
      "departmentId": {
        "type": "string",
        "default": "content",
        "description": "Department the team belongs to (must exist)"
      },
      "parentAgentId": {
        "type": "string",
        "default": "dir-content",
        "description": "Agent the channel manager reports to (must exist)"
      }
    }
  },
  "files": [
    {
      "kind": "team",
      "path": "objects/team.json"
    },
    {
      "kind": "agent",
      "path": "objects/agent-manager.json"
    },
    {
      "kind": "agent",
      "path": "objects/agent-producer.json"
    },
    {
      "kind": "agent",
      "path": "objects/agent-editor.json"
    },
    {
      "kind": "connection",
      "path": "objects/connection.json"
    }
  ]
}
