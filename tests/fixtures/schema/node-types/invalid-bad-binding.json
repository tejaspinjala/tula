{
  "_why": "input bindings reference trigger | params | nodes.<id>.output only",
  "_path": [
    "inputs",
    "note",
    "from"
  ],
  "id": "draft",
  "type": "agent",
  "label": "Writer: draft",
  "position": {
    "x": 200,
    "y": 0
  },
  "config": {
    "roleId": "writer",
    "tierOverride": "mid",
    "briefTemplate": "Draft a post from {{inputs.note}}",
    "acceptance": [
      "2 variants"
    ],
    "doneCondition": {
      "kind": "schema",
      "spec": "output"
    },
    "skills": [
      "voice"
    ],
    "narrowScope": {
      "read": [
        "brain/wiki/**"
      ]
    }
  },
  "inputs": {
    "note": {
      "from": "process.env.HOME"
    },
    "max": {
      "value": 2
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string"
      }
    }
  },
  "retry": {
    "max": 2,
    "backoffSec": 30
  },
  "onError": "edge",
  "maxUsd": 0.5
}
