{
  "id": "team-youtube-channel",
  "version": "1.0.0",
  "kinds": [
    "team"
  ],
  "requires": {},
  "files": [
    {
      "kind": "team",
      "path": "teams/youtube.json"
    }
  ],
  "params": {
    "type": "object",
    "required": [
      "channelName"
    ],
    "properties": {
      "channelName": {
        "type": "string",
        "default": "Main channel"
      },
      "mode": {
        "type": "string",
        "enum": [
          "api",
          "browser",
          "manual"
        ],
        "default": "manual"
      },
      "postsPerWeek": {
        "type": "integer",
        "default": 2
      },
      "dryRun": {
        "type": "boolean"
      }
    }
  }
}
