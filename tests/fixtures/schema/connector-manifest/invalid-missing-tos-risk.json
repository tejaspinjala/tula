{
  "_why": "tosRisk is required for every declared auth mode",
  "_path": [
    "tosRisk"
  ],
  "id": "youtube",
  "version": "0.1.0",
  "platform": "YouTube",
  "description": "One YouTube channel per connection",
  "authModes": [
    "api",
    "browser",
    "manual"
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "channelId": {
        "type": "string"
      },
      "defaultPrivacy": {
        "enum": [
          "private",
          "unlisted",
          "public"
        ],
        "default": "private"
      }
    },
    "required": [
      "channelId"
    ]
  },
  "requiredSecrets": {
    "api": [
      "oauth_client_id",
      "oauth_client_secret",
      "refresh_token"
    ],
    "browser": [],
    "manual": []
  },
  "actions": [
    {
      "id": "video.upload",
      "title": "Upload video",
      "effect": "write_external",
      "authModes": [
        "api",
        "browser",
        "manual"
      ],
      "inputSchema": {
        "type": "object",
        "required": [
          "fileRef",
          "title"
        ],
        "properties": {
          "fileRef": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "maxLength": 100
          },
          "description": {
            "type": "string"
          },
          "privacy": {
            "enum": [
              "private",
              "unlisted",
              "public"
            ]
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "videoUrl": {
            "type": "string"
          }
        }
      },
      "rateLimit": {
        "perDay": 3
      },
      "status": "planned"
    },
    {
      "id": "analytics.read",
      "title": "Read channel analytics",
      "effect": "read",
      "authModes": [
        "api"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "days": {
            "type": "integer"
          }
        }
      },
      "outputSchema": {
        "type": "object"
      },
      "status": "planned"
    }
  ],
  "healthCheck": {
    "everyMin": 360,
    "kind": "api_ping"
  },
  "tosRisk": {
    "api": "low",
    "manual": "low"
  },
  "netDomains": [
    "www.googleapis.com",
    "oauth2.googleapis.com",
    "studio.youtube.com",
    "accounts.google.com"
  ],
  "trust": "builtin"
}
