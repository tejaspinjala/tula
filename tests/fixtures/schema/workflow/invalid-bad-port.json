{
  "_why": "edge port must be default|true|false|error|each|done",
  "_path": [
    "edges",
    0,
    "port"
  ],
  "id": "wf-learning-to-linkedin",
  "version": 2,
  "name": "Learning to LinkedIn",
  "status": "active",
  "nodes": [
    {
      "id": "intake",
      "type": "trigger.event",
      "config": {
        "eventType": "brain.intake",
        "filter": {
          "==": [
            {
              "var": "source"
            },
            "owner"
          ]
        }
      }
    },
    {
      "id": "draft",
      "type": "agent",
      "label": "Writer: draft",
      "position": {
        "x": 200,
        "y": 0
      },
      "config": {
        "roleId": "writer",
        "tierOverride": "mid",
        "briefTemplate": "Draft a post from {{inputs.note}}",
        "acceptance": [
          "2 variants"
        ],
        "doneCondition": {
          "kind": "schema",
          "spec": "output"
        },
        "skills": [
          "voice"
        ],
        "narrowScope": {
          "read": [
            "brain/wiki/**"
          ]
        }
      },
      "inputs": {
        "note": {
          "from": "nodes.compile.output.notePath"
        },
        "max": {
          "value": 2
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        }
      },
      "retry": {
        "max": 2,
        "backoffSec": 30
      },
      "onError": "edge",
      "maxUsd": 0.5
    },
    {
      "id": "owner-ok",
      "type": "approval",
      "config": {
        "approver": "owner",
        "payloadFrom": "nodes.draft.output.contentHash",
        "expiresHours": 24
      }
    },
    {
      "id": "post",
      "type": "action",
      "config": {
        "connectionId": "linkedin-personal",
        "actionId": "post.manual",
        "approvalFrom": "owner-ok"
      }
    },
    {
      "id": "tell",
      "type": "notify",
      "config": {
        "message": "Posted",
        "priority": "default"
      }
    }
  ],
  "edges": [
    {
      "id": "a",
      "from": "intake",
      "to": "draft",
      "port": "maybe"
    },
    {
      "id": "b",
      "from": "draft",
      "to": "owner-ok"
    },
    {
      "id": "c",
      "from": "owner-ok",
      "to": "post"
    },
    {
      "id": "d",
      "from": "post",
      "to": "tell",
      "port": "default"
    }
  ]
}
