# Development values matching docker-compose.yml. Copy to .env; never commit real secrets.
# Owner connection: used only by `bun run db:migrate` and test setup.
DATABASE_URL=postgres://guildhall:guildhall@localhost:5432/guildhall
APP_DB_PASSWORD=guildhall-app-dev
# Non-owner guildhall_app connection: the only one the running app uses.
APP_DATABASE_URL=postgres://guildhall_app:guildhall-app-dev@localhost:5432/guildhall
DEV_GUILD_HEADER=true
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_BUCKET=guildhall-artifacts
OBJECT_STORE_ACCESS_KEY=guildhall
OBJECT_STORE_SECRET_KEY=guildhall-dev-secret
OBJECT_STORE_CREATE_BUCKET=true

# Member uuids (comma-separated) who may bar or lift every guild at once; empty means nobody.
PLATFORM_OPERATORS=

# Milliseconds between dispatch passes over every guild; unset leaves the in-process loop off.
# DISPATCH_INTERVAL_MS=5000
