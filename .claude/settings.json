{
  "autoCompactWindow": 200000,
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "35",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "3",
    "FLEET_CONTEXT_WINDOW": "200000"
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.pem)",
      "Bash(rm -rf /*)",
      "Bash(sudo *)",
      "Edit(./engine/approvals/**)",
      "Edit(~/.tula-fleet/approvals/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [
        { "type": "command", "command": "bun \"${CLAUDE_PROJECT_DIR}/engine/hooks/session-start.ts\"", "timeout": 10 },
        { "type": "command", "command": "bun \"${CLAUDE_PROJECT_DIR}/engine/hooks/event-log.ts\"", "timeout": 10 }
      ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [
        { "type": "command", "command": "bun \"${CLAUDE_PROJECT_DIR}/engine/hooks/context-guard.ts\"", "timeout": 10 },
        { "type": "command", "command": "bun \"${CLAUDE_PROJECT_DIR}/engine/hooks/event-log.ts\"", "timeout": 10 }
      ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash|Read|Write|Edit|MultiEdit|NotebookEdit|mcp__.*",
        "hooks": [ { "type": "command", "command": "bun \"${CLAUDE_PROJECT_DIR}/engine/hooks/security-gate.ts\"", "timeout": 10 } ] },
      { "matcher": "*",
        "hooks": [ { "type": "command", "command": "bun \"${CLAUDE_PROJECT_DIR}/engine/hooks/event-log.ts\"", "timeout": 10 } ] }
    ],
    "PostToolUse": [
      { "matcher": "Bash|mcp__.*",
        "hooks": [ { "type": "command", "command": "bun \"${CLAUDE_PROJECT_DIR}/engine/hooks/post-approval.ts\"", "timeout": 15 } ] },
      { "matcher": "*",
        "hooks": [ { "type": "command", "command": "bun \"${CLAUDE_PROJECT_DIR}/engine/hooks/context-guard.ts\"", "timeout": 10 } ] }
    ],
    "PostToolUseFailure": [
      { "matcher": "Bash|mcp__.*",
        "hooks": [ { "type": "command", "command": "bun \"${CLAUDE_PROJECT_DIR}/engine/hooks/post-approval.ts\"", "timeout": 15 } ] }
    ],
    "SubagentStart": [
      { "hooks": [ { "type": "command", "command": "bun \"${CLAUDE_PROJECT_DIR}/engine/hooks/event-log.ts\"", "timeout": 10 } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "bun \"${CLAUDE_PROJECT_DIR}/engine/hooks/event-log.ts\"", "timeout": 10 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "bun \"${CLAUDE_PROJECT_DIR}/engine/hooks/event-log.ts\"", "timeout": 10 } ] }
    ],
    "PreCompact": [
      { "hooks": [
        { "type": "command", "command": "bun \"${CLAUDE_PROJECT_DIR}/engine/hooks/pre-compact.ts\"", "timeout": 20 },
        { "type": "command", "command": "bun \"${CLAUDE_PROJECT_DIR}/engine/hooks/event-log.ts\"", "timeout": 10 }
      ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "bun \"${CLAUDE_PROJECT_DIR}/engine/hooks/event-log.ts\"", "timeout": 10 } ] }
    ]
  }
}
