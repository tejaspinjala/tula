{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Guildhall",
  "version": "0.1.0",
  "identifier": "app.guildhall.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost"
      }
    }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["guildhall"] } }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Game",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
