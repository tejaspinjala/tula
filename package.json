{
  "name": "guildhall",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky || true",
    "typecheck": "tsc --noEmit && bun run --filter '*' typecheck",
    "verify": "biome check . && bun run typecheck && bun test",
    "test:integration": "bun test ./apps/guildd/integration/migrate.integration.ts ./apps/guildd/integration/object-store.integration.ts ./apps/guildd/integration/sandbox.integration.ts ./apps/guildd/integration/egress.integration.ts ./scripts/backup-restore.integration.ts ./scripts/backup-services.integration.ts",
    "backup": "bun scripts/backup.ts",
    "restore": "bun scripts/restore.ts",
    "db:migrate": "bun run --cwd apps/guildd db:migrate",
    "start:selfhost": "bun scripts/start-selfhost.ts",
    "guild:enrol-link": "bun scripts/enrol-link.ts",
    "repo:setup": "bun scripts/repo-setup.ts",
    "test:db:prune": "bun scripts/drop-test-dbs.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.3",
    "husky": "^9.1.7",
    "postgres": "^3.4.9",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
